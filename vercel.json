{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.9.0",
      "maxDuration": 10
    }
  },
  "routes": [
    { "src": "^/(?:api|includes)(?:/.*)?$", "dest": "/api/index.php?__path=__blocked" },
    { "src": "^/(.*\\.(?:php|sql|txt|ini|md|json|lock|log|env|htaccess))$", "dest": "/api/index.php?__path=$1" },
    { "src": "^/(admin/?)?$", "dest": "/api/index.php?__path=$1" },
    { "src": "^/\\..*$", "dest": "/api/index.php?__path=__blocked" },
    { "handle": "filesystem" },
    { "src": "^/(images/.+)$", "dest": "/api/index.php?__path=$1" },
    { "src": "^/(.*)$", "dest": "/api/index.php?__path=$1" }
  ]
}
